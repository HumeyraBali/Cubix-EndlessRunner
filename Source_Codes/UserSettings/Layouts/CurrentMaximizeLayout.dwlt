    0\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.StickyNoteData\",\n   
    \"m_ObjectId\": \"114aed7bec1d4bdb802fad407602ca01\",\n    \"m_Title\": \"Masking
    out Stars\",\n    \"m_Content\": \"Using the Sun texture as a mask, we invert
    the colors and multiply it with the Stars. This way, no matter the sun texture
    or position, the Stars won't render in front of the Sun.\\n\\nNOTE: Stars will
    still show on Sun textures that aren't full black/white.\",\n    \"m_TextSize\":
    1,\n    \"m_Theme\": 1,\n    \"m_Position\": {\n        \"serializedVersion\":
    \"2\",\n        \"x\": 815.0,\n        \"y\": 241.0,\n        \"width\": 506.0,\n       
    \"height\": 328.0\n    },\n    \"m_Group\": {\n        \"m_Id\": \"\"\n    }\n}\n\n{\n   

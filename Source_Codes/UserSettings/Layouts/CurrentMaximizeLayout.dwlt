    {\n        \"m_SerializableColors\": []\n    }\n}\n\n{\n    \"m_SGVersion\":
    0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.StickyNoteData\",\n    \"m_ObjectId\":
    \"2d8398ab4ca641bc964034ce39dddbcf\",\n    \"m_Title\": \"Sun UV Position\",\n   
    \"m_Content\": \"These nodes take the world position and projects it flat into
    the sky.\\n\\nThe Matix4x4 Property takes the\\nrotation of the Direction Light,
    which the script is\\napplied to. This gives it the ability to project the Sun
    Mask in the right position in the sky.\\n\\nThe Matrix4x4 (referenced as _LightMatrix)
    Property should not be exposed.\",\n    \"m_TextSize\": 0,\n    \"m_Theme\":
    1,\n    \"m_Position\": {\n        \"serializedVersion\": \"2\",\n        \"x\":
    -2191.199951171875,\n        \"y\": -504.79998779296877,\n        \"width\":
    267.199951171875,\n        \"height\": 200.79998779296876\n    },\n    \"m_Group\":
    {\n        \"m_Id\": \"\"\n    }\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\":
